// alu_{{ width }}bit_{{ ops | join('_') }}{% if signed %}_signed{% endif %}{% if unsigned %}_unsigned{% endif %}.sv
module alu_add (
    input  logic [{{ width-1 }}:0] A,
    input  logic [{{ width-1 }}:0] B,
    input  logic [{{ op_width-1 }}:0] opcode,
    input  logic en,

    output logic [{{ width-1 }}:0] result
);

    // Localparam opcodes
    {% for op in ops %}
    localparam [{{ op_width - 1 }}:0] OPCODE_{{ op.upper() }} = {{ op_width }}'b{{ op_code[op] }};
    {% endfor %}

    // Internal computation signals
    logic [{{ width }}:0] extended_sub;
    {% if signed %}
    logic signed_less, signed_greater, signed_less_equal, signed_greater_equal;
    logic sign_flag, overflow_flag;
    {% endif %}
    {% if unsigned %}
    logic unsigned_less, unsigned_greater, unsigned_less_equal, unsigned_greater_equal;
    {% endif %}
    logic zero_flag;

    // Compute flags and comparison results
    always_comb begin
        extended_sub = {1'b0, A} - {1'b0, B};
        zero_flag = (extended_sub[{{ width-1 }}:0] == 0);
        
        {% if signed %}
        // Signed comparison logic
        sign_flag = extended_sub[{{ width }}];
        overflow_flag = (A[{{ width-1 }}] != B[{{ width-1 }}]) && (extended_sub[{{ width-1 }}] != A[{{ width-1 }}]);
        signed_less = sign_flag ^ overflow_flag;
        signed_greater = !(sign_flag ^ overflow_flag || zero_flag);
        signed_less_equal = (sign_flag ^ overflow_flag) || zero_flag;
        signed_greater_equal = !(sign_flag ^ overflow_flag);
        {% endif %}
        
        {% if unsigned %}
        // Unsigned comparison logic  
        unsigned_less = extended_sub[{{ width }}];  // Borrow occurred
        unsigned_greater = !extended_sub[{{ width }}] && !zero_flag;
        unsigned_less_equal = extended_sub[{{ width }}] || zero_flag;
        unsigned_greater_equal = !extended_sub[{{ width }}];
        {% endif %}
    end

    // Result logic
    always_comb begin
        result = {{ width }}'b0; // Default result
        if (en) begin
            case (opcode)
                {% if 'add' in ops %}
                OPCODE_ADD: result = A + B;
                {% endif %}
                {% if 'sub' in ops %}
                OPCODE_SUB: result = A - B;
                {% endif %}
                {% if 'lt' in ops %}
                OPCODE_LT: begin
                    {% if signed %}
                    result = signed_less ? { {{width}}{1'b1}} : { {{width}}{1'b0}};
                    {% endif %}
                    {% if unsigned %}
                    result = unsigned_less ? { {{width}}{1'b1}} : { {{width}}{1'b0}};
                    {% endif %}
                end
                {% endif %}
                {% if 'gt' in ops %}
                OPCODE_GT: begin
                    {% if signed %}
                    result = signed_greater ? { {{width}}{1'b1}} : { {{width}}{1'b0}};
                    {% endif %}
                    {% if unsigned %}
                    result = unsigned_greater ? { {{width}}{1'b1}} : { {{width}}{1'b0}};
                    {% endif %}
                end
                {% endif %}
                {% if 'le' in ops %}
                OPCODE_LE: begin
                    {% if signed %}
                    result = signed_less_equal ? { {{width}}{1'b1}} : { {{width}}{1'b0}};
                    {% endif %}
                    {% if unsigned %}
                    result = unsigned_less_equal ? { {{width}}{1'b1}} : { {{width}}{1'b0}};
                    {% endif %}
                end
                {% endif %}
                {% if 'ge' in ops %}
                OPCODE_GE: begin
                    {% if signed %}
                    result = signed_greater_equal ? { {{width}}{1'b1}} : { {{width}}{1'b0}};
                    {% endif %}
                    {% if unsigned %}
                    result = unsigned_greater_equal ? { {{width}}{1'b1}} : { {{width}}{1'b0}};
                    {% endif %}
                end
                {% endif %}
                default:    result = {{ width }}'b0;
            endcase
        end
    end

endmodule